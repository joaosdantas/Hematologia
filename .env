# Domínio canônico do site — usado em index.html (canonical, og:url, og:image).
# TODO: ajustar para o domínio real antes de publicar.
VITE_SITE_URL=https://doutoraugusto.com.br

# WordPress headless — apenas a API REST é consumida; o painel fica em wp-admin.
# A URL abaixo é a raiz do WP (sem /wp-json).
VITE_WP_API_URL=https://blog.doutoraugusto.com.br
# Fallback enquanto o DNS do subdomínio não propaga (mesmo projeto da Vercel).
VITE_WP_API_FALLBACK_URL=https://blog-doutoraugusto.vercel.app
